# Server-only credentials. Use the dedicated SELECT-only role from migration 0010.
HACKSNAP_WEB_DATABASE_URL=postgresql://hacksnap_reader.PROJECT_REF:password@your-pooler:6543/postgres?sslmode=verify-full
# The website never accepts SUPABASE_PASSWORD or the postgres login.
# Never prefix this setting with NEXT_PUBLIC_.

# Use the Supabase transaction pooler for Vercel; copy the URL from Connect.
