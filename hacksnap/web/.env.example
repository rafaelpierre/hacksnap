# Server-only credentials. Use the dedicated SELECT-only role from migration 0010.
HACKSNAP_WEB_DATABASE_URL=postgresql://hacksnap_reader.PROJECT_REF:password@your-pooler:6543/postgres?sslmode=verify-full
# The website never accepts SUPABASE_PASSWORD or the postgres login.
# Never prefix this setting with NEXT_PUBLIC_.

# Use the Supabase transaction pooler for Vercel; copy the URL from Connect.
# Supabase connections automatically use the bundled CA and verify-full TLS.

# Set false and redeploy to hide discussion analysis without changing stored data.
HACKSNAP_DISCUSSION_RENDERING=true

# Optional server-only first-party view/click collection (migration 0019).
# Provision LOGIN/password for hacksnap_counter separately. Leave unset to disable.
# The reader connection above stays SELECT-only; never reuse administrator credentials.
HACKSNAP_POPULARITY_DATABASE_URL=
# Example: postgresql://hacksnap_counter.PROJECT_REF:password@your-pooler:6543/postgres?sslmode=verify-full
