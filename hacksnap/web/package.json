{
  "name": "hacksnap-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:story-ui": "npm test -- tests/story-content.test.tsx tests/story-added-time.test.tsx tests/story-navigation.test.tsx",
    "test:theme": "npm test -- tests/theme.test.mjs tests/theme-toggle.test.tsx",
    "test:analytics": "npm test -- tests/analytics.test.mjs tests/analytics-return.test.mjs tests/analytics-dom.test.mjs",
    "test:metadata": "npm test -- tests/preview-metadata.test.mjs",
    "test:share": "npm test -- tests/share-menu.test.mjs",
    "test:archive": "npm test -- tests/archive.test.mjs",
    "test:api": "npm test -- tests/api.test.mjs",
    "test:history": "npm test -- tests/rank-history.test.mjs tests/story-metrics.test.mjs",
    "test:categories": "npm test -- tests/categories.test.mjs tests/navigation-context.test.mjs",
    "test:brief": "npm test -- tests/brief.test.mjs",
    "test": "TZ=America/Los_Angeles node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "npm test -- --ci",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "browser:build": "node scripts/browser-app.mjs build",
    "browser:start": "node scripts/browser-app.mjs start",
    "test:browser": "playwright test",
    "test:browser:ci": "npm run browser:build && npm run test:browser"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1",
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/twitter-text": "3.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.2",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sharp": "0.35.4",
    "typescript": "^7.0.2"
  }
}
