# Existing project pooler; alternatively provide HACKSNAP_DATABASE_URL.
SUPABASE_PASSWORD=

# Modal-hosted OpenAI-compatible endpoint. Include /v1; no trailing slash needed.
MODAL_LLM_BASE_URL=https://rafaelpierre--ep-deepseek-v4-1-flash-server.us-west.modal.direct/v1
MODAL_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# GLM alternative: replace both values above with these values.
# MODAL_LLM_BASE_URL=https://rafaelpierre--ep-glm-5-3-flash-server.us-west.modal.direct/v1
# MODAL_LLM_MODEL=zai-org/GLM-5.3-Flash
MODAL_LLM_REASONING_EFFORT=low
# For managed Modal Endpoints: proxy token ID and secret joined with a period.
MODAL_LLM_API_KEY=

# Local runs only. Modal installs this executable into /usr/local/bin/kestrel.
KESTREL_BINARY=kestrel

# Article images: enable only after the image migration and a successful canary.
HACKSNAP_IMAGES_ENABLED=false
# Server-side write token for a PUBLIC Vercel Blob store; never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Optional bounded image processing settings; see docs/images/rollout.md.
HACKSNAP_IMAGE_BATCH_SIZE=10
HACKSNAP_IMAGE_PUBLISHER_INTERVAL=2
HACKSNAP_IMAGE_TIMEOUT=8
HACKSNAP_IMAGE_MAX_BYTES=8000000
HACKSNAP_IMAGE_MAX_HTML_BYTES=1000000
HACKSNAP_IMAGE_MIN_WIDTH=600
HACKSNAP_IMAGE_MIN_HEIGHT=300
HACKSNAP_IMAGE_MAX_CANDIDATES=12
HACKSNAP_IMAGE_MAX_REDIRECTS=3
HACKSNAP_IMAGE_MAX_ATTEMPTS=3
